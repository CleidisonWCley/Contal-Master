; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ContalMaster"
config/version="0.13.4"
run/main_scene="res://scenes/loading/LoadingScreen.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.25662142, 0.14212537, 0.42546546, 1)
boot_splash/image="uid://cmp14rltfrr3c"
config/icon="res://assets/contalmaster_icon.png"

[autoload]

ScoreManager="*res://scripts/autoloads/ScoreManager.gd"
SettingsManager="*res://scripts/autoloads/SettingsManager.gd"
AudioManager="*res://scripts/autoloads/AudioManager.gd"
DifficultyManager="*res://scripts/autoloads/DifficultyManager.gd"
GameManager="*res://scripts/autoloads/GameManager.gd"
AchievementManager="*res://scripts/autoloads/AchievementManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
