[node name="SidePropMarkers" type="Node2D" parent="."]
editor_description = "Markers editáveis dos objetos laterais do Desvio Lógico. Arraste cada ponto sobre o gramado do cenário. V0.16.11.1: os markers PostLeft*/PostRight* (Start = perto da placa, Mid = meio, End = canto inferior) sao os pontos dos 6 POSTES FIXOS na calçada (o lado direito é espelhado do esquerdo) e também guiam as listras do gramado."

[node name="PostRightStart" type="Marker2D" parent="SidePropMarkers"]
editor_description = "Trilha direita distante. Trilha das listras do gramado (V0.16.11: nao ha mais poste). Ponto sobre o CENTRO DA CALCADA (faixa cinza/roxa entre o gramado e o asfalto)."
position = Vector2(721, 250)

